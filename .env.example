# Auth Configuration
AUTH_URL=https://onthepixel.net
AUTH_SECRET=YOUR_AUTH_SECRET_HERE

# Discord OAuth
AUTH_DISCORD_ID=YOUR_DISCORD_CLIENT_ID
AUTH_DISCORD_SECRET=YOUR_DISCORD_CLIENT_SECRET

# --- Dashboard authorisation ---------------------------------------------
# WHO may use /dashboard and the /api/dashboard/** routes is decided by Pocket
# ID, not by a list here. Rights are per dashboard area and per level, and they
# are custom claims on the Pocket ID GROUP, next to `Team`, `prefix`, `weight`
# and `Discord-role-id`:
#
#   Permission-news       0/unset = kein Zugriff
#   Permission-creators   1       = lesen              (GET)
#   Permission-team       2       = lesen + schreiben  (POST/PUT/PATCH)
#   Permission-apply      3       = zusätzlich löschen (DELETE)
#
# Anything that is not exactly 1, 2 or 3 — missing, empty, "true", "4" — counts
# as 0. Somebody in several OTP groups gets the HIGHEST level per area. The
# dashboard opens for anybody with a level above 0 somewhere; the areas they
# have nothing in are not even shown in the navigation.
#
# The groups themselves still have to carry `Team=OTP`: only those grant
# anything. Both sign-in methods resolve to the same Pocket ID user — an OIDC
# login is matched on its `sub`, a Discord login on the `Discord-id` custom
# claim the team dashboard stores on each member. Ranks and their levels are
# edited in the dashboard under Team → Gruppen.
# This needs a working POCKETID_APIKEY (see below).
#
# SET THIS BEFORE THE FIRST DEPLOY OF THE PERMISSION FEATURE. Immediately after
# deploying, NO group carries a `Permission-*` claim yet, so NOBODY has access —
# including whoever would have to set those claims. ADMIN_EMAILS is the only
# thing that still gets in, and everybody listed gets level 3 in every area.
#
# EMERGENCY ACCESS ONLY beyond that. Comma-separated email addresses that are
# let in without consulting Pocket ID, for every provider. Empty it again once
# the ranks carry their levels — anything listed here bypasses the team roster
# and keeps working after the account is removed from the team. Server-side
# only: do NOT add a NEXT_PUBLIC_ prefix.
# ADMIN_EMAILS=you@example.com
#
# The decision is made at sign-in and re-checked about every 15 minutes, so
# removing somebody from the OTP group, or lowering a rank's levels, takes
# effect within that window. It is fail-closed: an account that cannot be proven
# to hold a level gets no access (401 without a session, 403 with one) and the
# server logs why.
#
# NOTE, deliberate: `Permission-team` >= 2 is what lets somebody edit ranks, and
# ranks are where these claims live — so anyone at that level can raise their
# own rights. Treat `Permission-team` >= 2 as "team administrator".

# Local development only: enables the role picker on /dashboard/login, so you
# can enter the dashboard without Discord/Pocket ID. Requires a non-production
# build AND this explicit opt-in. A production build or start with this set
# fails hard on purpose, so put it in `.env.development.local` (only read by
# `next dev`) rather than in `.env` / `.env.local`.
# AUTH_DEV_LOGIN=1

# PocketID (Team management) — API key sent as the X-API-KEY header.
# NOTE: use an underscore, not a dash. A dashed name (pocketid-apikey) is not a
# valid shell identifier and breaks env sourcing in bash-based build pipelines
# (e.g. Coolify's `source build-time.env` fails with exit code 127).
POCKETID_APIKEY=YOUR_POCKETID_API_KEY
# Optional override of the PocketID base URL (defaults to https://auth.onthepixel.net)
# POCKETID_API_URL=https://auth.onthepixel.net

# --- Discord role sync (OPTIONAL) ---------------------------------------
# Hands out Discord roles when a team member or creator is created, changed or
# deleted in the dashboard. Leave BOTH variables empty and the dashboard keeps
# working exactly as before, just without the role sync — nothing here is
# required for the site to run.
#
# Setup, once:
#  1. Discord Developer Portal -> Applications -> <app> -> Bot -> "Reset Token",
#     and put the value below. Server-side only: a NEXT_PUBLIC_ prefix would
#     publish the token to every visitor and hand over the whole server.
#  2. Invite the bot with the `bot` scope and the "Manage Roles" permission
#     (MANAGE_ROLES = 268435456):
#     https://discord.com/oauth2/authorize?client_id=<APP_ID>&scope=bot&permissions=268435456
#     No privileged gateway intent is needed.
#  3. THE STEP EVERYONE MISSES: Server Settings -> Roles, drag the bot's own
#     role ABOVE every role it is supposed to hand out. Discord refuses to touch
#     a role that sits at or above the bot's highest role even with
#     "Manage Roles", and answers 403 / code 50013. The dashboard reports that
#     case with the fix spelled out.
#  4. Enable Developer Mode (User Settings -> Advanced), right-click the server
#     -> "Copy Server ID" for DISCORD_GUILD_ID.
#
# Which role belongs to which rank is NOT configured here: it is a custom claim
# on the Pocket ID group (`Discord-role-id`), edited under Team -> Gruppen in
# the dashboard. The rank marked there as "Creator-Rang" (`Creator=true`)
# supplies the role every creator receives.
# DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID
#
# Optional override of the Discord API base URL (defaults to
# https://discord.com/api/v10). Exists for pointing the sync at a local mock
# during testing; leave it unset in production.
# DISCORD_API_URL=https://discord.com/api/v10

# --- Database -----------------------------------------------------------
# PostgreSQL connection string. Read by the app and by drizzle-kit
# (`npm run db:migrate`, `npm run db:seed`), which pick it up from `.env`.
#
# The value below is the local Docker stack from compose.yml — copy this file to
# `.env` and it works as-is after `npm run db:up`. For a deployed environment,
# replace it with the real connection string and add `?sslmode=require` when the
# database is reached over the public internet; the driver honours `sslmode`
# from the URL and defaults to a plaintext connection when it is absent.
DATABASE_URL=postgres://onthepixel:onthepixel@localhost:5432/onthepixel

# Host port the local PostgreSQL container publishes. Change it if 5432 is
# already taken, and update the port in DATABASE_URL to match.
# POSTGRES_PORT=5432

# Schema bootstrap in the request path. Off by default: the schema is owned by
# the migrations in `drizzle/` and applied with `npm run db:migrate` at deploy
# time. Set to 1 only for a throwaway local database you do not want to migrate
# by hand — it makes the app issue CREATE TABLE IF NOT EXISTS statements before
# its first query on every cold start.
# DB_AUTO_MIGRATE=1
